<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_customer_category_tree" model="ir.ui.view">
        <field name="name">customer.category.tree</field>
        <field name="model">customer.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_customer_category_form" model="ir.ui.view">
        <field name="name">customer.category.form</field>
        <field name="model">customer.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" string="Category Name"/>
                        <field name="is_bh" invisible="1"/>
                    </group>
                    <notebook>
                        <page string="Water Tiers" invisible="is_bh">
                            <field name="water_tier_ids"
                                   context="{'default_tier_type': 'water'}">
                                <list editable="bottom">
                                    <field name="from_unit" string="From Unit"/>
                                    <field name="to_unit" string="To Unit"/>
                                    <field name="price_per_unit" string="Price (KSh/unit)"/>
                                    <field name="tier_type" invisible="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sewerage Tiers">
                            <field name="sewerage_tier_ids"
                                   context="{'default_tier_type': 'sewerage'}">
                                <list editable="bottom">
                                    <field name="from_unit" string="From Unit"/>
                                    <field name="to_unit" string="To Unit"/>
                                    <field name="price_per_unit" string="Price (KSh/unit)"/>
                                    <field name="tier_type" invisible="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_customer_category" model="ir.actions.act_window">
        <field name="name">Customer Categories</field>
        <field name="res_model">customer.category</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_customer_category"
              name="Customer Categories"
              parent="account.menu_finance_configuration"
              action="action_customer_category"
              sequence="6"/>

</odoo>
