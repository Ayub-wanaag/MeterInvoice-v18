<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_form_inherit_category" model="ir.ui.view">
        <field name="name">res.partner.form.category</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='vat']" position="after">
                <field name="account_number" placeholder="e.g. 1048506 (7 digits)"/>
                <field name="customer_category_id" string="Customer Category"/>
                <label for="meter_number"/>
                <div class="o_row">
                    <field name="meter_number"
                           placeholder="e.g. NCWSC 12345678"
                           readonly="id and meter_number"/>
                    <button name="%(action_meter_swap_wizard)d"
                            type="action"
                            string="Swap Meter"
                            class="btn-link"
                            context="{'default_partner_id': id}"
                            invisible="not id or not meter_number"/>
                </div>
            </xpath>

            <xpath expr="//page[@name='internal_notes']" position="before">
                <page string="Billing Category" name="billing_category">
                    <group>
                        <group>
                            <field name="account_number" string="Account Number" readonly="1"/>
                            <field name="customer_category_id" string="Category" readonly="1"/>
                            <field name="meter_number" readonly="1"/>
                            <field name="is_bh" invisible="1"/>
                        </group>
                    </group>
                    <notebook invisible="not customer_category_id">
                        <page string="Water Tiers" invisible="is_bh">
                            <field name="category_water_tier_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="from_unit" string="From"/>
                                    <field name="to_unit" string="To"/>
                                    <field name="price_per_unit" string="Price (KSh)"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sewerage Tiers">
                            <field name="category_sewerage_tier_ids" readonly="1" nolabel="1">
                                <list>
                                    <field name="from_unit" string="From"/>
                                    <field name="to_unit" string="To"/>
                                    <field name="price_per_unit" string="Price (KSh)"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </page>
            </xpath>

        </field>
    </record>

    <record id="view_partner_tree_inherit_category" model="ir.ui.view">
        <field name="name">res.partner.tree.category</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phone']" position="after">
                <field name="account_number" string="Account No." optional="show"/>
                <field name="customer_category_id" string="Category" optional="show"/>
                <field name="meter_number" string="Meter No." optional="show"/>
            </xpath>
        </field>
    </record>

    <record id="action_sync_meter_history_server" model="ir.actions.server">
        <field name="name">Sync Existing Meters to History</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = env['res.partner'].action_sync_meter_history()
        </field>
    </record>

</odoo>
