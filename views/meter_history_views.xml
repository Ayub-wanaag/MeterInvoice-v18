<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_meter_history_tree" model="ir.ui.view">
        <field name="name">meter.history.tree</field>
        <field name="model">meter.history</field>
        <field name="arch" type="xml">
            <list string="Meter Assignment History">
                <field name="account_number"/>
                <field name="partner_id"/>
                <field name="meter_number"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="final_reading"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'replaced'"/>
            </list>
        </field>
    </record>

    <record id="view_meter_history_form" model="ir.ui.view">
        <field name="name">meter.history.form</field>
        <field name="model">meter.history</field>
        <field name="arch" type="xml">
            <form string="Meter History Entry">
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="active,replaced"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="account_number"/>
                            <field name="meter_number"/>
                        </group>
                        <group>
                            <field name="final_reading"/>
                            <field name="start_date"/>
                            <field name="end_date" invisible="state == 'active'"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes" placeholder="Notes on installation or swap reasons..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_meter_history_search" model="ir.ui.view">
        <field name="name">meter.history.search</field>
        <field name="model">meter.history</field>
        <field name="arch" type="xml">
            <search string="Search Meter History">
                <field name="partner_id"/>
                <field name="account_number"/>
                <field name="meter_number"/>
                <filter string="Active Meters" name="active_meters" domain="[('state', '=', 'active')]"/>
                <filter string="Replaced Meters" name="replaced_meters" domain="[('state', '=', 'replaced')]"/>
                <group>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_meter_history" model="ir.actions.act_window">
        <field name="name">Meter Assignment History</field>
        <field name="res_model">meter.history</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_meter_history_search"/>
        <field name="context">{'search_default_active_meters': 1}</field>
    </record>

    <menuitem id="menu_meter_history"
              name="Meter History"
              action="action_meter_history"
              sequence="20"/>

</odoo>
