<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_inherit_water" model="ir.ui.view">
        <field name="name">product.template.form.water</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <!-- Odoo 18/19 removed the "Can be Purchased" checkbox+label pair
                 from this header area, so anchor on the still-present
                 "Can be Sold" (sale_ok) label instead. -->
            <xpath expr="//label[@for='sale_ok']" position="after">
                <field name="is_water"/>
                <label for="is_water" string="Is Water Product"/>
            </xpath>

            <xpath expr="//page[@name='sales']" position="before">
                <page string="Billing Tiers"
                      name="billing_tiers_tab"
                      invisible="not is_water">
                    <field name="water_tier_ids"
                           readonly="1"
                           nolabel="1">
                        <list>
                            <field name="name" string="Category"/>
                        </list>
                        <form>
                            <sheet>
                                <group>
                                    <field name="name" string="Category"/>
                                </group>
                                <notebook>
                                    <page string="Water Tiers">
                                        <field name="water_tier_ids">
                                            <list>
                                                <field name="from_unit" string="From"/>
                                                <field name="to_unit" string="To"/>
                                                <field name="price_per_unit" string="Price (KSh)"/>
                                            </list>
                                        </field>
                                    </page>
                                    <page string="Sewerage Tiers">
                                        <field name="sewerage_tier_ids">
                                            <list>
                                                <field name="from_unit" string="From"/>
                                                <field name="to_unit" string="To"/>
                                                <field name="price_per_unit" string="Price (KSh)"/>
                                            </list>
                                        </field>
                                    </page>
                                </notebook>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>

        </field>
    </record>
</odoo>
